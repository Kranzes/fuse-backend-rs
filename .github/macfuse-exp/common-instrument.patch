+    /// CI experiment: print `ls -la@` of each directory, to show whether
+    /// macOS stored xattrs in AppleDouble `._` files.
+    fn dump(dirs: &[&str]) {
+        for dir in dirs {
+            match Command::new("ls").arg("-la@").arg(dir).output() {
+                Ok(o) => println!(
+                    "=== e2e dump: ls -la@ {}\n{}{}",
+                    dir,
+                    String::from_utf8_lossy(&o.stdout),
+                    String::from_utf8_lossy(&o.stderr)
+                ),
+                Err(e) => println!("=== e2e dump: ls -la@ {}: {}", dir, e),
+            }
+        }
+    }
+
+    /// `exec` that dumps `dirs` before panicking on a failure.
+    fn exec_dump(cmd: &str, dirs: &[&str]) -> String {
+        let output = Command::new("sh")
+            .arg("-c")
+            .arg(cmd)
+            .env("RUST_BACKTRACE", "1")
+            .output()
+            .unwrap();
+        if !output.status.success() || !output.stderr.is_empty() {
+            dump(dirs);
+            panic!(
+                "exec failed: {}: {}",
+                cmd,
+                String::from_utf8_lossy(&output.stderr)
+            );
+        }
+        String::from_utf8_lossy(&output.stdout).to_string()
+    }
+
     /// Like `exec`, but a failure is an `Err` instead of a panic — for steps
     /// whose acceptable outcome depends on kernel-side behavior. Unlike
     /// `exec`, stderr on success is not treated as a failure.
