+/// E4: wait up to 10 s for the go-nfsv4 helper to exit, and say how long
+/// it took on stderr.
+fn reap_helper(pid: Pid) {
+    let start = std::time::Instant::now();
+    loop {
+        match waitpid(pid, Some(WaitPidFlag::WNOHANG)) {
+            Ok(WaitStatus::StillAlive) if start.elapsed().as_secs() < 10 => {
+                std::thread::sleep(std::time::Duration::from_millis(10));
+            }
+            Ok(WaitStatus::StillAlive) => {
+                eprintln!("e2e: go-nfsv4 {} still running 10 s after unmount", pid);
+                return;
+            }
+            r => {
+                eprintln!(
+                    "e2e: go-nfsv4 {} reaped {} ms after unmount: {:?}",
+                    pid,
+                    start.elapsed().as_millis(),
+                    r
+                );
+                return;
+            }
+        }
+    }
+}
